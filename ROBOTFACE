// Variables
var color = randomNumber(1, 255);
var shoePosition1 = randomNumber(100, 130);
var shoePosition2 = randomNumber(180, 300);
var backgroundColor = randomNumber(1,255);
var eyePosition1 = randomNumber(250, 230);
var eyePosition2 = randomNumber(180,210);
var antennaEnd = randomNumber(70,10);

// Background
background(rgb(randomNumber(1,255),backgroundColor,randomNumber(1,255)));

// Antennas
shape(200, 100, 316, antennaEnd);
shape(176, 100, 116, antennaEnd);
fill(randomNumber(1,255),randomNumber(1,255),randomNumber(1,255));
ellipse(316,antennaEnd,30,30);
ellipse(116,antennaEnd,30,30);

// Triangle
fill(color,color,color);
shape(200, 50, 50, 350, 350, 350);

// Eyes
fill(rgb(randomNumber(1,255),randomNumber(1,255),randomNumber(1,255)));
ellipse(200, 200, 60, 60);
ellipse(150, 250, 60, 60);
ellipse(250, 250, 60, 60);

// Pupils
fill("red");
ellipse(150,eyePosition1,30,30);
ellipse(250,eyePosition1,30,30);
ellipse(200, eyePosition2,30,30);

// Ears 
fill("blue");
rect(shoePosition1, 350, 50, 20);
rect(shoePosition2, 350, 50, 20);

// Mouth
fill(rgb(randomNumber(1,255), randomNumber(1,255), randomNumber(1,255)));
shape(120, 300, 200, 330, 275, 300);
